# Node / Vite
node_modules/
dist/
*.log

# Local environment and secrets
.env
.env.*
!.env.desktop
!.env.desktop-online
!.env.desktop-student
!.env.example

# Generated release configuration and Tauri build cache
src-tauri/tauri.release.conf.json
src-tauri/target/
src-tauri/generated/
server/target/
.tmp-runtime/

# Generated native CPython runtime
runtime/native/dist/python-runtime/*
!runtime/native/dist/python-runtime/.gitkeep
runtime/native/dist/*.log

# Generated JupyterLite site (rebuilt by npm run build:runtime)
public/runtime/
!public/runtime/.gitkeep

# JupyterLite runtime packaging input (synced from public/course by build:runtime)
notebooks/course/*
!notebooks/course/.gitkeep

# 本地化的 Pyodide / piplite 资源（由 npm run build:runtime:assets 下载，约 150 MB）
public/pyodide/
public/piplite/

# Auth server persistent data (server/)
server-data/

# Python / notebook caches
__pycache__/
*.py[cod]
.pytest_cache/
.pep8-course-cells/
.ipynb_checkpoints/

# Local raw dataset archives and duplicate source files
datasets/

# Local screenshots and audit exports
audit-*.png
vite-*.log
dev-server*.log

# Windows shortcuts
*.lnk
# Generated release artifacts
release/

# Session scratch / agent logs / audit outputs (keep local only)
.agent-teams/
.dsh-work/
.backup-course-prefix/
.pep8-viz2/
.tmp/
logs/
python/
.tmp*
_*.txt
_*.cjs
verify_ch*.py
scripts/*.bak*

