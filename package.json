{
  "name": "python-data-studio",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite --mode web --host 127.0.0.1",
    "dev:desktop": "vite --mode desktop --host 127.0.0.1",
    "dev:desktop:student": "vite --mode desktop-student --host 127.0.0.1",
    "auth:dev": "cargo run --manifest-path server/Cargo.toml",
    "build": "npm run build:web",
    "build:web": "node scripts/build-web.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "build:course": "python scripts/enhance-notebooks-for-beginners.py && python scripts/prune-redundant-notebook-sections.py && python scripts/build-python-foundation-module.py && python scripts/format-course-notebooks.py && python scripts/close-notebook-learning-loops.py && python scripts/enrich-module-intro-checkpoints.py && python scripts/enrich-notebook-math.py && python scripts/normalize-notebook-architecture.py --sync-runtime && node scripts/sync-catalog.mjs && python scripts/maintain-teaching-resources.py --write && python scripts/normalize-notebook-architecture.py --scope app",
    "rebuild:course:generated": "node scripts/rebuild-course-notebooks.mjs && python scripts/enhance-notebooks-for-beginners.py && python scripts/prune-redundant-notebook-sections.py && python scripts/build-python-foundation-module.py && python scripts/format-course-notebooks.py && python scripts/close-notebook-learning-loops.py && python scripts/enrich-module-intro-checkpoints.py && python scripts/enrich-notebook-math.py && python scripts/normalize-notebook-architecture.py --sync-runtime && node scripts/sync-catalog.mjs && python scripts/maintain-teaching-resources.py --write && python scripts/normalize-notebook-architecture.py --scope app",
    "prune:notebooks": "python scripts/prune-redundant-notebook-sections.py",
    "normalize:notebooks": "python scripts/normalize-notebook-architecture.py",
    "check:notebooks": "python scripts/normalize-notebook-architecture.py --check",
    "check:module-intros": "python scripts/enrich-module-intro-checkpoints.py --check",
    "check:notebook-math": "python scripts/enrich-notebook-math.py --check",
    "build:teaching": "python scripts/maintain-teaching-resources.py --write && python scripts/normalize-notebook-architecture.py --scope app && node scripts/sync-catalog.mjs",
    "check:teaching": "python scripts/maintain-teaching-resources.py --check",
    "test:teaching": "python -m unittest scripts/test_teaching_resources.py -v",
    "check:pep8": "python scripts/check-course-pep8.py",
    "format:course": "python scripts/format-course-notebooks.py",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "build:extensions": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-extensions.ps1",
    "build:runtime": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-runtime.ps1",
    "build:native-runtime": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-native-runtime.ps1",
    "tauri": "tauri",
    "desktop:dev": "npm run desktop:dev:student",
    "desktop:dev:full": "tauri dev --features desktop-debug",
    "desktop:dev:student": "tauri dev --features desktop-debug --config src-tauri/tauri.student-dev.conf.json",
    "desktop:build": "npm run desktop:build:student:debug",
    "desktop:build:full": "tauri build",
    "desktop:build:student": "npm run desktop:build:student:debug",
    "desktop:build:student:release": "tauri build --config src-tauri/tauri.student.conf.json",
    "desktop:build:student:debug": "tauri build --debug --features desktop-debug --config src-tauri/tauri.student-debug.conf.json --bundles nsis",
    "desktop:build:online": "node scripts/prepare-tauri-release.mjs && npm run build:course && tauri build --config src-tauri/tauri.release.conf.json && node scripts/generate-updater-manifest.mjs",
    "build:desktop-web": "node scripts/build-desktop-web.mjs --mode desktop",
    "build:desktop-web:student": "node scripts/build-desktop-web.mjs --mode desktop-student",
    "build:desktop-web:online": "node scripts/build-desktop-web.mjs --mode desktop-online",
    "updater:manifest": "node scripts/generate-updater-manifest.mjs",
    "release": "node scripts/release.mjs",
    "release:verify": "node scripts/verify-release-assets.mjs",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@emotion/react": "latest",
    "@emotion/styled": "latest",
    "@jupyterlab/nbformat": "^4.5.10",
    "@jupyterlab/services": "^7.6.2",
    "@mui/icons-material": "latest",
    "@mui/material": "latest",
    "@mui/x-charts": "latest",
    "@mui/x-tree-view": "^9.11.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.12",
    "papaparse": "^5.5.4",
    "plotly.js-dist-min": "^3.7.0",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "react-router-dom": "latest",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "thebe-core": "^0.5.0",
    "zustand": "latest"
  },
  "devDependencies": {
    "@jupyterlab/application": "^4.6.0",
    "@jupyterlab/builder": "^4.5.10",
    "@jupyterlab/coreutils": "^6.5.10",
    "@jupyterlab/docmanager": "^4.6.0",
    "@jupyterlab/notebook": "^4.6.0",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-react": "latest",
    "esbuild": "^0.28.1",
    "lightningcss": "^1.33.0",
    "picomatch": "^4.0.5",
    "rolldown": "~1.2.0",
    "tinyglobby": "^0.2.17",
    "vite": "^8.2.0"
  }
}
