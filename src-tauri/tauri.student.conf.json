{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Python Data Studio",
  "identifier": "com.python.datastudio",
  "build": {
    "beforeBuildCommand": "npm run build:desktop-web:student"
  },
  "app": {
    "windows": [
      {
        "title": "Python Data Studio",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "minWidth": 1100,
        "minHeight": 720,
        "center": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"]
  }
}
