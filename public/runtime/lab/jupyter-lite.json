{
  "jupyter-config-data": {
    "appUrl": "/lab",
    "mode": "multiple-document",
    "settingsOverrides": {
      "@jupyter-notebook/notebook-extension:full-width-notebook": {
        "fullWidthNotebook": true
      },
      "@jupyterlab/application-extension:shell": {
        "dockPanelPadding": false,
        "startMode": "single"
      },
      "@jupyterlab/translation-extension:plugin": {
        "locale": "zh_CN"
      }
    },
    "settingsUrl": "../build/schemas",
    "showLoadingIndicator": true,
    "themesUrl": "./build/themes"
  },
  "jupyter-lite-schema-version": 0
}